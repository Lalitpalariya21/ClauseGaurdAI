# ClauseGuard AI Environment Configuration

# Optional: Groq API Key (leave empty to use the 100% Offline AI Engine without any API calls)
GROQ_API_KEY=

# LLM Model (Default: openai/gpt-oss-20b via Groq)
DEFAULT_MODEL=openai/gpt-oss-20b
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# RAG & Embedding Settings
EMBEDDING_MODEL=all-MiniLM-L6-v2
FAISS_TOP_K=5

# Document Chunking Settings
CHUNK_SIZE=800
CHUNK_OVERLAP=150
